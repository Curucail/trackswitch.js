{
	"$schema": "https://audiolabs.github.io/trackswitch.js/schema/trackswitch.schema.json",
	"media": {
		"violins": {
			"type": "audio",
			"title": "Violins",
			"src": "../../assets/multitracks/violins.mp3",
			"solo": true
		},
		"synths": {
			"type": "audio",
			"title": "Synths",
			"src": "../../assets/multitracks/synth.mp3",
			"solo": true
		},
		"bass": {
			"type": "audio",
			"title": "Bass",
			"src": "../../assets/multitracks/bass.mp3",
			"solo": true
		},
		"drums": {
			"type": "audio",
			"title": "Drums",
			"src": "../../assets/multitracks/drums.mp3",
			"solo": true
		}
	},
	"views": [
		{
			"type": "navigationBar",
			"controls": ["playback", "seekBar", "timer"]
		},
		{
			"type": "text",
			"text": "\"center\"",
			"bold": true,
			"fontSize": 14,
			"align": "left"
		},
		{
			"type": "waveform",
			"tracks": "audible",
			"height": 70,
			"defaultZoom": 10,
			"playbackFollowMode": "center"
		},
		{
			"type": "text",
			"text": "\"jump\"",
			"bold": true,
			"fontSize": 14,
			"align": "left"
		},
		{
			"type": "waveform",
			"tracks": "audible",
			"height": 70,
			"defaultZoom": 10,
			"playbackFollowMode": "jump"
		},
		{
			"type": "text",
			"text": "\"off\"",
			"bold": true,
			"fontSize": 14,
			"align": "left"
		},
		{
			"type": "waveform",
			"tracks": "audible",
			"height": 70,
			"defaultZoom": 10,
			"playbackFollowMode": "off"
		},
		{
			"type": "trackList",
			"tracks": ["violins", "synths", "bass", "drums"]
		}
	]
}
