{
	"$schema": "https://audiolabs.github.io/trackswitch.js/schema/trackswitch.schema.json",
	"media": {
		"violins": {
			"type": "audio",
			"title": "Violins",
			"src": "../../assets/multitracks/violins.mp3",
			"solo": true
		},
		"synths": {
			"type": "audio",
			"title": "Synths",
			"src": "../../assets/multitracks/synth.mp3",
			"solo": true
		},
		"bass": {
			"type": "audio",
			"title": "Bass",
			"src": "../../assets/multitracks/bass.mp3",
			"solo": true
		},
		"drums": {
			"type": "audio",
			"title": "Drums",
			"src": "../../assets/multitracks/drums.mp3",
			"solo": true
		}
	},
	"views": [
		{
			"type": "navigationBar",
			"controls": [
				"playback",
				"seekBar",
				"timer"
			]
		},
		{
			"type": "text",
			"text": "All audible tracks",
			"bold": true,
			"fontSize": 14,
			"align": "left"
		},
		{
			"type": "waveform",
			"tracks": "audible",
			"height": 100
		},
		{
			"type": "text",
			"text": "Bass",
			"bold": true,
			"fontSize": 14,
			"align": "left"
		},
		{
			"type": "waveform",
			"tracks": [
				"bass"
			],
			"height": 70
		},
		{
			"type": "text",
			"text": "Drums",
			"bold": true,
			"fontSize": 14,
			"align": "left"
		},
		{
			"type": "waveform",
			"tracks": [
				"drums"
			],
			"height": 70
		},
		{
			"type": "trackList",
			"tracks": [
				"violins",
				"synths",
				"bass",
				"drums"
			],
			"trackVolumeControls": true
		}
	]
}
