{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "URL of the published JSON Schema. Ignored by the player; editors read it to offer completion and validation while a config file is being written."
		},
		"media": {
			"$ref": "#/definitions/MediaConfig"
		},
		"alignment": {
			"$ref": "#/definitions/AlignmentConfig"
		},
		"markers": {
			"$ref": "#/definitions/MarkersConfig"
		},
		"presets": {
			"$ref": "#/definitions/PresetsConfig"
		},
		"views": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/TrackSwitchViewConfig"
			}
		},
		"features": {
			"type": "object",
			"properties": {
				"muteOtherPlayerInstances": {
					"type": "boolean"
				},
				"customizablePanelOrder": {
					"type": "boolean"
				},
				"tabView": {
					"type": "boolean"
				},
				"keyboard": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		},
		"css": {
			"$ref": "#/definitions/TrackSwitchCssOverrides",
			"description": "Theming overrides for the whole player."
		}
	},
	"required": [
		"media",
		"views"
	],
	"additionalProperties": false,
	"definitions": {
		"MediaConfig": {
			"type": "object",
			"additionalProperties": {
				"$ref": "#/definitions/MediaEntryConfig"
			},
			"propertyNames": {
				"description": "A media id doubles as a timeline id; a track id is a media id restricted to `type: 'audio'`."
			}
		},
		"MediaEntryConfig": {
			"oneOf": [
				{
					"$ref": "#/definitions/AudioMediaEntryConfig"
				},
				{
					"$ref": "#/definitions/MidiMediaEntryConfig"
				},
				{
					"$ref": "#/definitions/MusicXmlMediaEntryConfig"
				},
				{
					"$ref": "#/definitions/ImageMediaEntryConfig"
				}
			]
		},
		"AudioMediaEntryConfig": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "audio"
				},
				"src": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"timelineUnit": {
					"$ref": "#/definitions/TimelineUnit",
					"description": "The unit this medium's positions are expressed in: its alignment column is read in it, and every surface the medium owns reads out in it. Omitted, the medium uses the native unit of its type."
				},
				"imageID": {
					"$ref": "#/definitions/MediaId",
					"description": "Names an `image` media entry shown by a `perTrackImage` view while this track is the only soloed one. Being a medium, it carries its own alignment column, so a per-stem spectrogram seeks and folds markers like any other timed image."
				},
				"css": {
					"$ref": "#/definitions/TrackSwitchCssOverrides"
				},
				"solo": {
					"type": "boolean"
				},
				"volume": {
					"type": "number"
				},
				"pan": {
					"type": "number"
				},
				"startOffsetMs": {
					"type": "number"
				},
				"endOffsetMs": {
					"type": "number"
				},
				"srcSynchronized": {
					"$ref": "#/definitions/SynchronizedAudioSourceConfig"
				}
			},
			"required": [
				"type",
				"src"
			],
			"additionalProperties": false
		},
		"TimelineUnit": {
			"type": "string",
			"enum": [
				"seconds",
				"samples",
				"ticks",
				"measures",
				"percent",
				"pixels"
			],
			"description": "The unit a timeline's alignment column is authored in. Each medium has one native unit it plays back in (audio and MIDI: seconds, a score: measures, an image: percent of its width); the others are declared alternatives that are converted to the native unit when the alignment is parsed — see `src/timeline/media-profile.ts`."
		},
		"MediaId": {
			"type": "string",
			"description": "A media id doubles as a timeline id; a track id is a media id restricted to `type: 'audio'`."
		},
