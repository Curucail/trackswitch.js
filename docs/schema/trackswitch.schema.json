			"description": "Whether a fixed-track waveform uses the shared duration or its own duration."
		},
		"TrackSwitchMidiViewConfig": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "midi"
				},
				"mediaID": {
					"$ref": "#/definitions/MediaId"
				},
				"height": {
					"type": "number"
				},
				"maxZoom": {
					"type": "number"
				},
				"defaultZoom": {
					"type": "number"
				},
				"playbackFollowMode": {
					"$ref": "#/definitions/WaveformPlaybackFollowMode"
				},
				"timer": {
					"type": "boolean"
				},
				"pianoKeyboard": {
					"type": "boolean",
					"description": "Draws a piano keyboard beside the pitch axis and pins the playhead to its edge, so the notes fly into the keys and the key of every sounding note lights up in the colour of its channel. Defaults to `false`."
				},
				"noteRange": {
					"$ref": "#/definitions/MidiNoteRange",
					"description": "The pitch axis of the roll. `\"automatic\"` (the default) spans every note of the file with two semitones of padding on each side; a pair fixes it."
				},
				"velocityBars": {
					"type": "boolean",
					"description": "Draws a bar inside each note event showing its velocity. Defaults to `false`."
				},
				"velocityOpacity": {
					"type": "boolean",
					"description": "Fades note events by their velocity rather than drawing them solid. Defaults to `false`."
				},
				"channelToTrackIDMap": {
					"type": "object",
					"additionalProperties": {
						"anyOf": [
							{
								"$ref": "#/definitions/TrackId"
							},
							{
								"type": "array",
								"items": {
									"$ref": "#/definitions/TrackId"
								}
							}
						]
					},
					"description": "Pairs MIDI channels with audio tracks, keyed by channel number. A paired channel is drawn while any of its tracks is audible — naming every track of a `soloGroup` keeps the channel visible as the selection moves between them. Two channels may name the same track; the track's row then splits its colour across both."
				},
				"colorPerChannel": {
					"type": "boolean",
					"description": "Gives every channel in the file its own palette colour, independently of `channelToTrackIDMap`. Defaults to `true`. With this off, every channel draws in the plain, unpaired colour regardless of the map."
				},
				"markerLayers": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/MarkerLayerConfig"
					}
				},
				"css": {
					"$ref": "#/definitions/TrackSwitchCssOverrides"
				}
			},
			"required": [
				"type",
				"mediaID"
			],
			"additionalProperties": false
		},
